rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Editores: podem ler e gravar. Qualquer outro usuário logado só pode ler.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'gabrielvspm1@gmail.com',
          'secmobilidadeurbana@gmail.com'
        ];
    }
    match /cameras/{id} {
      allow read: if request.auth != null;
      allow write: if isEditor();
    }
    match /config/{id} {
      allow read: if request.auth != null;
      allow write: if isEditor();
    }
  }
}
